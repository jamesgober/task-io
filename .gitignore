# Development (dev/ is committed; .dev/ and .claude/ stay local)
/.dev
/.claude

# Rust / Cargo
/target/
**/*.rs.bk

# Benchmark and fuzz output
/compare/target/
/compare/fang/target/
/compare/effectum/target/
/compare/results/raw/
/compare/results/*-quick.md
/fuzz/target/
/fuzz/corpus/
/fuzz/artifacts/

# Editor & OS junk
/.vscode
.DS_Store
Thumbs.db
Desktop.ini

# Secrets
.env

# Libraries do not commit the lockfile
Cargo.lock

# ...except the harness, whose competitor versions must stay pinned
!/compare/Cargo.lock
!/compare/fang/Cargo.lock
!/compare/effectum/Cargo.lock
